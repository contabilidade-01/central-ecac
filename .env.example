# =============================================================================
# Central Pendências e-CAC — variáveis de ambiente
#
# Copie para `.env` (local) ou cadastre no painel "Environment" do EasyPanel.
# O `.env` está no .gitignore e NUNCA deve ir para o repositório.
#
# (As variáveis SERPRO_BASE_URL / MAX_WORKERS / FLASK_ENV que existiam aqui antes
#  eram do código inventado — nenhuma delas é lida pelo sistema.)
# =============================================================================

# -----------------------------------------------------------------------------
# OBRIGATÓRIAS EM PRODUÇÃO
# -----------------------------------------------------------------------------

# Onde ficam banco, PDFs, certificados e logs. No servidor tem de apontar para o
# VOLUME PERSISTENTE, senão cada redeploy apaga os dados.
DATA_DIR=/data

# Assina a sessão. Gere uma nova, não use esta:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Login: NÃO é mais obrigatório definir aqui.
#
# A partir do 10º desvio o sistema tem TELA DE LOGIN. Na primeira vez que você abrir o
# endereço, ele leva para /primeiro-acesso, onde você define usuário e senha — gravados
# em HASH em <DATA_DIR>/instance/usuarios.json, dentro do volume. Sem credencial, o
# sistema NÃO abre nenhuma tela.
#
# As duas variáveis abaixo continuam funcionando como alternativa (compatibilidade com o
# 7º desvio e útil para scripts/curl via HTTP Basic). O arquivo tem precedência sobre elas.
# AUTH_USER=nescon
# AUTH_PASSWORD=troque-por-uma-senha-forte

# Marca o cookie de sessão como "secure" — o navegador só o envia por HTTPS.
# LIGUE (1) em produção. Deixe desligado localmente, senão o login por http:// não funciona.
SESSION_COOKIE_SECURE=1

# -----------------------------------------------------------------------------
# AUTOMAÇÃO (agendamento das rotinas)
# -----------------------------------------------------------------------------

# Liga o agendador. Já vem ligado na imagem Docker; fora dela fica DESLIGADO para que
# rodar o sistema na sua máquina não dispare chamada paga sem você pedir.
SCHEDULER_ENABLED=1

# De quanto em quanto tempo o agendador verifica se há rotina vencida (segundos).
SCHEDULER_INTERVALO_S=300

# Teto MENSAL de gasto com a API, em reais. 0 = sem teto.
# Ao atingir, as rotinas param de gastar, avisam na tela /agendamento e, na execução
# seguinte, CONTINUAM DE ONDE PARARAM (não repetem empresa já consultada).
# Também pode ser definido pela tela; a variável de ambiente tem prioridade.
LIMITE_GASTO_MENSAL=0

# -----------------------------------------------------------------------------
# INTEGRAÇÃO COM O PORTAL DO CLIENTE (nescon-clientes) — 18º desvio
# -----------------------------------------------------------------------------

# Token que o portal apresenta no cabeçalho X-Integracao-Token para /api/interno/*.
# MÍNIMO 32 caracteres (menor é ignorado). O MESMO valor vai em ECAC_INTEGRACAO_TOKEN
# no nescon-clientes. Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = integração desligada (as rotas respondem 503).
INTEGRACAO_TOKEN=

# Quantas guias pagas por dia o portal pode emitir para a mesma empresa/competência
# (clique repetido não vira conta; guia válida é reaproveitada do disco, sem custo).
INTEGRACAO_MAX_EMISSOES_DIA=3

# Quantos reprocessamentos de situação fiscal por empresa por mês o portal pode pedir
# ("regere 5 dias úteis depois do recálculo"). Cada um é uma consulta paga.
INTEGRACAO_MAX_REPROC_MES=2

# -----------------------------------------------------------------------------
# WHATSAPP (uazapi) — 19º desvio. As MESMAS credenciais e regras do portal nescon-clientes.
# -----------------------------------------------------------------------------

# Instância uazapi (mesma do portal: mesmo número). Vazio = WhatsApp desligado aqui.
UAZAPI_SUBDOMAIN=
UAZAPI_TOKEN=

# Trava: só manda para número cadastrado na tela /contatos (empresa ativa) ou do
# escritório. Desligar só em emergência.
# WHATSAPP_SO_CLIENTES=true

# Números do escritório (recebem teste/aviso interno e passam pela trava).
ADMIN_WHATSAPP=
ESCRITORIO_WHATSAPP=

# Anti-bloqueio do número. ⚠️ O teto por hora é por processo e o portal tem o dele; como a
# instância é uma só, a SOMA dos dois deve ficar abaixo do que o número aguenta.
ALERTAS_THROTTLE_S=0.6
ALERTAS_MAX_POR_HORA=90
ALERTAS_DELAY_MS=1200

# -----------------------------------------------------------------------------
# OPCIONAIS
# -----------------------------------------------------------------------------

# Porta interna do container (o EasyPanel aponta o domínio para ela).
PORT=5847

# Fuso — mantém datas e logs no horário de Brasília.
TZ=America/Sao_Paulo

# =============================================================================
# O QUE **NÃO** VAI AQUI
# =============================================================================
# As credenciais da SERPRO (consumer key/secret), o CNPJ do contador e a senha do
# certificado A1 NÃO são variáveis de ambiente: ficam no BANCO, cadastradas pela tela
# de Configurações do próprio sistema (tabela `settings`).
#
# O certificado .pfx é um ARQUIVO: suba para o volume em
# `<DATA_DIR>/certificates/contador_certificado.pfx` e informe o caminho na tela de
# Configurações. Ver docs/DEPLOY_EASYPANEL.md, passo 6.
